<div class="container py-5" style="max-width: 560px;">
  <div class="card">
    <div class="card-body p-4">
      <h1 class="h4 fw-semibold mb-3">Baseline</h1>
      <p class="text-body-secondary mb-4">
        Tennis player profile and head-to-head analysis for USTA league captains.
      </p>

      <div class="d-flex gap-2">
        <%= link_to "Admin", admin_root_path, class: "btn btn-primary btn-sm" %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-outline-secondary btn-sm" %>
      </div>
    </div>
  </div>
</div>
