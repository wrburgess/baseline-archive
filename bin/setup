#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

def step(name)
  puts "\n== #{name} =="
end

FileUtils.chdir APP_ROOT do
  # Idempotent — safe to re-run at any time.

  step "Installing gem dependencies"
  system("bundle check") || system!("bundle install")

  step "Installing JavaScript dependencies"
  if system("command -v corepack > /dev/null 2>&1")
    system!("corepack enable")
  end
  system!("yarn install")

  step "Building assets"
  system!("yarn build")
  system!("yarn build:css")

  step "Preparing database"
  system!("bin/rails db:prepare")
  system!("bin/rails db:reset") if ARGV.include?("--reset")

  step "Installing git hooks"
  system!("bin/install-git-hooks") if File.exist?("bin/install-git-hooks")

  step "Removing old logs and tempfiles"
  system!("bin/rails log:clear tmp:clear")

  unless ARGV.include?("--skip-server")
    step "Starting development server"
    STDOUT.flush
    exec "bin/dev"
  end
end
